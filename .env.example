# Copy this file to .env.local and fill in the four values. See docs/setup.md.
#
# Expo builds every EXPO_PUBLIC_ value into the app, where anyone can read it.
# These four are meant to be public. Never put a secret key, a client secret,
# or a database password in this file.

# Supabase dashboard > Project Settings > API Keys
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Cloud console > Google Auth Platform > Clients
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
